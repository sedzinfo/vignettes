    "engine": "knitr",
    "markdown": "---\ntitle: \"Arctic Sea Ice Is Melting\"\ndescription: \"Arctic sea ice decline from the NSIDC Sea Ice Index in R: the September minimum since 1979 as a time series and maps of the ice edge drawn with sf and ggplot2.\"\nsubtitle: \"Visualising 45 years of decline with real NSIDC data\"\nauthor: \"\"\n---\n\n\n\n## Background\n\nEvery September the Arctic sea ice reaches its annual minimum after the summer melt season. The **National Snow and Ice Data Center (NSIDC)** has been tracking this since 1979 using satellite passive-microwave sensors. Their **Sea Ice Index v4.0** is the authoritative public record.\n\nThis document shows you exactly how to download the real data and reproduce the charts below — no manual downloads, no hardcoded numbers.\n\n---\n\n## Packages\n\n\n::: {.cell}\n\n```{.r .cell-code}\n# install any missing packages before running\n# install.packages(c(\"plotly\", \"ggplot2\", \"sf\", \"rnaturalearth\", \"rnaturalearthdata\"))\n\nlibrary(plotly)\nlibrary(ggplot2)\nlibrary(sf)\nlibrary(rnaturalearth)\n```\n:::\n\n\n---\n\n## Part 1 — Time series\n\n### Download the data\n\nNSIDC publishes one CSV per month. September (month 09) is the annual minimum.\n\n\n::: {.cell}\n\n```{.r .cell-code}\ncsv_url<-\"https://noaadata.apps.nsidc.org/NOAA/G02135/north/monthly/data/N_09_extent_v4.0.csv\"\n\narctic<-read.csv(csv_url,strip.white=TRUE)\narctic<-arctic[arctic$year>=1979,c(\"year\",\"extent\")]\nrownames(arctic)<-NULL\n\nhead(arctic)\n```\n\n::: {.cell-output .cell-output-stdout}\n\n```\n  year extent\n1 1979   7.05\n2 1980   7.67\n3 1981   7.14\n4 1982   7.30\n5 1983   7.39\n6 1984   6.81\n```\n\n\n:::\n:::\n\n\n### Plot\n\n\n::: {.cell}\n\n```{.r .cell-code}\navg_baseline<-mean(arctic$extent[arctic$year<=1990])\nloss_pct<-round((1-min(arctic$extent)/avg_baseline)*100)\n\ncol_fill<-\"#B3E5FC\"\ncol_line<-\"#0277BD\"\ncol_trend<-\"#C62828\"\ncol_record<-\"#E65100\"\ncol_ref<-\"#78909C\"\ncol_title<-\"#0D1B40\"\n\nrecords<-arctic[arctic$year%in%c(2007,2012,2020),]\nlow<-arctic[which.min(arctic$extent),]\n# the straight-line trend and its 95% confidence band\ntrend<-predict(lm(extent~year,data=arctic),interval=\"confidence\")\n\nplot_ly(arctic,x=~year) %>%\n  add_trace(y=~extent,type=\"scatter\",mode=\"none\",fill=\"tozeroy\",fillcolor=toRGB(col_fill,0.55),\n            hoverinfo=\"skip\") %>%\n  add_ribbons(ymin=trend[,\"lwr\"],ymax=trend[,\"upr\"],line=list(width=0),\n              fillcolor=toRGB(\"#FFCDD2\",0.25),hoverinfo=\"skip\") %>%\n  add_lines(y=trend[,\"fit\"],line=list(color=col_trend,width=3,dash=\"dash\"),\n            hovertemplate=\"Trend, %{x}: %{y:.2f} million km²<extra></extra>\") %>%\n  add_lines(y=~extent,line=list(color=col_line,width=2.5),\n            hovertemplate=\"%{x}: %{y:.2f} million km²<extra></extra>\") %>%\n  add_markers(data=records,y=~extent,marker=list(color=col_record,size=12),\n              hovertemplate=\"%{x}: %{y:.2f} million km²<extra></extra>\") %>%\n  layout(title=list(text=paste0(\"<b>Arctic Sea Ice Is Melting</b><br>\",\n                                \"<span style='font-size:13px;color:#737373'>September \",\n                                \"minimum sea ice extent, 1979 to present</span>\"),\n                    x=0.02,xanchor=\"left\",y=0.97,yanchor=\"top\",font=list(size=20,color=col_title)),\n         showlegend=FALSE,plot_bgcolor=\"#F0F8FF\",xaxis=list(title=\"\",tick0=1980,dtick=5),\n         yaxis=list(title=\"Extent (million km²)\",ticksuffix=\" M\",rangemode=\"tozero\"),\n         shapes=list(list(type=\"line\",xref=\"paper\",x0=0,x1=1,y0=avg_baseline,y1=avg_baseline,\n                          line=list(color=col_ref,dash=\"dot\",width=1.5))),\n         annotations=list(list(x=1981,y=avg_baseline+0.18,text=\"1979-1990 mean\",showarrow=FALSE,\n                               xanchor=\"left\",font=list(size=11,color=col_ref)),\n                          list(x=low$year,y=low$extent,ax=0,ay=45,\n                               text=paste0(\"<b>Record low<br>\",round(low$extent,2),\" M km² (\",\n                                           low$year,\")</b>\"),\n                               arrowcolor=col_record,arrowhead=0,\n                               font=list(size=11,color=col_record)),\n                          list(x=max(arctic$year),y=max(arctic$extent)*0.93,\n                               text=paste0(\"<b>-\",loss_pct,\"% vs.<br>1979-1990 avg</b>\"),\n                               showarrow=FALSE,xanchor=\"right\",font=list(size=16,color=col_trend)),\n                          list(text=\"Source: NSIDC Sea Ice Index v4.0 | noaadata.apps.nsidc.org\",\n                               xref=\"paper\",yref=\"paper\",x=1,y=-0.08,xanchor=\"right\",yanchor=\"top\",\n                               showarrow=FALSE,font=list(size=10,color=\"#999999\"))),\n         margin=list(t=80,b=60)) %>%\n  config(displaylogo=FALSE)\n```\n\n::: {.cell-output-display}\n\n```{=html}\n<div class=\"plotly html-widget html-fill-item\" id=\"htmlwidget-d315b02cf5e8147aa20b\" style=\"width:100%;height:576px;\"></div>\n<script type=\"application/json\" data-for=\"htmlwidget-d315b02cf5e8147aa20b\">{\"x\":{\"visdat\":{\"dc09e4665ddb0\":[\"function () \",\"plotlyVisDat\"],\"dc09e1cd71752\":[\"function () \",\"data\"]},\"cur_data\":\"dc09e1cd71752\",\"attrs\":{\"dc09e4665ddb0\":{\"x\":{},\"alpha_stroke\":1,\"sizes\":[10,100],\"spans\":[1,20],\"y\":{},\"type\":\"scatter\",\"mode\":\"none\",\"fill\":\"tozeroy\",\"fillcolor\":\"rgba(179,229,252,0.55)\",\"hoverinfo\":\"skip\",\"inherit\":true},\"dc09e4665ddb0.1\":{\"x\":{},\"alpha_stroke\":1,\"sizes\":[10,100],\"spans\":[1,20],\"ymin\":[7.2921128961716644,7.22749425325771,7.1627600565763112,7.097898450263866,7.0328960962450866,6.967737976700775,6.9024071751597234,6.8368846373559764,6.7711489151799036,6.7051759003341411,6.638938559020942,6.5724066854948218,6.5055467008713421,6.4383215341966089,6.3706906348977634,6.3026101778425181,6.2340335314043527,6.1649120604594092,6.0951963238647018,6
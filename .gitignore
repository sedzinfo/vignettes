# Quarto sites: keep sources and _freeze/, ignore build leftovers.
# The rendered sites live in docs/, written by the GitHub workflow.
quarto/*/.quarto/
quarto/*/_site/
quarto/*/docs/
quarto/*/site_libs/
quarto/*/*.html
quarto/*/*.rmarkdown
quarto/*/*.knit.md
quarto/*/*_cache/
quarto/*/*_files/
# gifs written next to the Rmds by anim_save(); pages embed their own copies from _freeze/
quarto/*/*.gif
# except gifs a page links to directly (keep these tracked)
!quarto/illustration/arctic_ice_animated.gif
!quarto/illustration/climate_spiral.gif
!quarto/illustration/eu_salary_race.gif
quarto/**/*.quarto_ipynb

# R session files
.Rproj.user/
.Rhistory
.RData

# local builds made by render.R
_preview/

# Quarto sites: keep sources and _freeze/, ignore build leftovers.
# The rendered sites live in docs/, written by the GitHub workflow.
quarto/*/.quarto/
quarto/*/_site/
quarto/*/docs/
quarto/*/site_libs/
quarto/*/*.html
quarto/*/*.rmarkdown
quarto/*/*.knit.md
quarto/*/*_cache/
quarto/*/*_files/
quarto/**/*.quarto_ipynb

# R session files
.Rproj.user/
.Rhistory
.RData
